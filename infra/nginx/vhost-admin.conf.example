# ── Панель управления на поддомене (правка 30.10) ─────────────────────
# НЕ подключён: nginx -t упадёт без сертификата, а CD проверяет конфиг.
# Включить, когда в DNS (Бегет) есть запись:
#   admin.kooperativ.space  A  45.11.92.174
# Порядок на сервере:
#   1. certbot certonly --webroot -w /var/www/certbot -d admin.kooperativ.space
#      (или --nginx, если так выпускали основной сертификат)
#   2. переименовать файл в vhost-admin.conf и добавить ссылку в CD рядом
#      с vhost-vps.conf (cd.yml, шаг «Reload public nginx routing»)
#   3. в сборке фронта задать VITE_ADMIN_ORIGIN=https://admin.kooperativ.space —
#      тогда /admin основного сайта уводит на поддомен
#   4. в vhost-vps.conf закрыть /api/admin/ на основном домене (return 404)
server {
    listen 80;
    listen 443 ssl;
    server_name admin.kooperativ.space;

    ssl_certificate     /etc/letsencrypt/live/admin.kooperativ.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.kooperativ.space/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Панель не должна попадать в поиск.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Frame-Options "DENY" always;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    # Тот же фронт, что и у игры: на хосте admin. он сразу открывает панель.
    location /api/ {
        limit_req zone=koop_auth burst=20 nodelay;
        proxy_pass http://127.0.0.1:4080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Адрес клиента — перезаписью, как в vhost-vps.conf.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
    }
}
