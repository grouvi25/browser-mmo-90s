# Root .env.example — копируй в .env и заполни реальными значениями
# Никогда не коммить .env с реальными секретами!

# --- Backend ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

JWT_SECRET=change_me_to_random_secret_32_chars
JWT_EXPIRES_IN=7d

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mmo90s_dev
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_TITLE=MMO 90-х
