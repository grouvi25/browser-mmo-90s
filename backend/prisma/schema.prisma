model ItemTemplate {
  id                  String             @id @default(uuid())
  code                String             @unique // e.g. "weapon_knife_basic"
  name                String
  description         String?
  type                ItemType
  craftProfessionCode String?            @map("craft_profession_code")
  battleExpBonus      Float              @default(0) @map("battle_exp_bonus")
  statBudget          Int                @default(0) @map("stat_budget")
  statAllocation      Json?              @map("stat_allocation")
  /// Прибавки к характеристикам персонажа, пока вещь надета: { str, end, luck, agi, acc, agr } (правка 26.10).
  statBonuses         Json?              @map("stat_bonuses")
  allocationMode      ItemAllocationMode @default(FIXED) @map("allocation_mode")
  weaponType          WeaponType?        @map("weapon_type")
  armorSlot           ArmorSlot?         @map("armor_slot")

  // Weapon stats
  minDamage       Int?   @map("min_damage")
  maxDamage       Int?   @map("max_damage")
  weaponAccuracy  Float? @default(0.7) @map("weapon_accuracy")
  critBonus       Float? @default(0.0) @map("crit_bonus")
  critDamageBonus Float? @default(0.0) @map("crit_damage_bonus")
  blockPierce     Float? @default(0.0) @map("block_pierce")
  antiDodge       Float? @default(0.0) @map("anti_dodge")
  antiLuck        Float? @default(0.0) @map("anti_luck")
  antiCounter     Float? @default(0.0) @map("anti_counter")

  // Armor stats
  armor      Int?   @default(0)
  dodgeBonus Float? @default(0.0) @map("dodge_bonus")
  antiCrit   Float? @default(0.0) @map("anti_crit")
  blockBonus Float? @default(0.0) @map("block_bonus")
  hpBonus    Int?   @default(0) @map("hp_bonus")

  // Distance (зональная боёвка): дальность оружия. Ближнее = 1 (только вплотную)
  optimalRange Int? @default(1) @map("optimal_range")
  maxRange     Int? @default(1) @map("max_range")

  // Physical
  weight               Float       @default(1.0)
  durabilityMax        Int         @default(100) @map("durability_max")
  qualityBase          ItemQuality @default(COMMON) @map("quality_base")
  priceBase            Int         @default(100) @map("price_base")
  itemTier             Int         @default(1) @map("item_tier")
  requiredRepairParts  Json?       @map("required_repair_parts")
  requiredUpgradeParts Json?       @map("required_upgrade_parts")
  toolTier             Int?        @map("tool_tier")
  usesMax              Int?        @map("uses_max")
  privateShopAllowed   Boolean     @default(false) @map("private_shop_allowed")
  upgradeAllowed       Boolean     @default(false) @map("upgrade_allowed")
  repairResourceCode   String?     @map("repair_resource_code")

  // Requirements
  levelReq Int @default(0) @map("level_req")
  skillReq Int @default(0) @map("skill_req") // мин. уровень навыка
  strReq   Int @default(0) @map("str_req")

  // Meta
  sourceType   ItemSourceType @default(GOVERNMENT) @map("source_type")
  isActive     Boolean        @default(true) @map("is_active")
  isSellable   Boolean        @default(true) @map("is_sellable")
  isEquippable Boolean        @default(true) @map("is_equippable")
  isTradeable  Boolean        @default(true) @map("is_tradeable")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  instances   ItemInstance[]
  shopEntries GovernmentShopItem[]

  @@map("item_templates")
}

model ItemInstance {
  id         String @id @default(uuid())
  templateId String @map("template_id")
  ownerId    String @map("owner_id")

  quality              ItemQuality @default(COMMON)
  durabilityCurrent    Int         @map("durability_current")
  durabilityMax        Int         @map("durability_max")
  upgradeLevel         Int         @default(0) @map("upgrade_level")
  upgradeModifiersJson Json?       @map("upgrade_modifiers_json")
  statAllocation       Json?       @map("stat_allocation")
  freePoints           Int         @default(0) @map("free_points")
  // Гнёзда под камни: [{ stone, cut }], не длиннее SOCKETS_PER_ITEM.
  socketsJson          Json?       @map("sockets_json")
  usesLeft             Int?        @map("uses_left")

  status     ItemStatus @default(NORMAL)
  isEquipped Boolean    @default(false) @map("is_equipped")
  armorSlot  ArmorSlot? @map("armor_slot") // если экипировано, какой слот

  weight     Float
  sourceType ItemSourceType @map("source_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  template         ItemTemplate @relation(fields: [templateId], references: [id])
  owner            Character    @relation("OwnerItems", fields: [ownerId], references: [id], onDelete: Cascade)
  itemLogs         ItemLog[]
  repairLogs       RepairLog[]
  workShiftsAsTool WorkShift[]  @relation("WorkShiftTool")

  // Battle: участник может использовать/менять оружие
  battleTurnsWeapon BattleTurn[] @relation("TurnWeapon")

  @@index([ownerId])
  @@index([templateId])
  @@index([ownerId, status])
  @@map("item_instances")
}

// =============================================================
// GOVERNMENT SHOP
// =============================================================

model GovernmentShopItem {
  id            String  @id @default(uuid())
  templateId    String  @map("template_id")
  isAvailable   Boolean @default(true) @map("is_available")
  overridePrice Int?    @map("override_price") // если null — берём priceBase
  sortOrder     Int     @default(0) @map("sort_order")

  template ItemTemplate @relation(fields: [templateId], references: [id])

  @@unique([templateId])
  @@map("shop_items_government")
}

// =============================================================
// BOTS
// =============================================================

model Bot {
  id          String @id @default(uuid())
  code        String @unique // e.g. "training_bandit", "basic_gangster"
  name        String
  battleLevel Int    @default(1) @map("battle_level")
  power       Int    @default(10)
  hpMax       Int    @map("hp_max")

  // Stats as JSON (same structure as CharacterStats)
  stats Json // { str, agi, rea, acc, end, luck, agr }

  // Equipment as JSON list of template codes
  equipment Json // { mainWeapon: "code", armor: {...} }

  // Reward config
  expReward      Int @default(10) @map("exp_reward")
  moneyRewardMin Int @default(0) @map("money_reward_min")
  moneyRewardMax Int @default(0) @map("money_reward_max")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  battleParticipants BattleParticipant[]

  @@map("bots")
}

// =============================================================
// BATTLES
// =============================================================

model Battle {
  id     String       @id @default(uuid())
  type   BattleType
  status BattleStatus @default(CREATED)

  winnerId            String? @map("winner_id") // legacy character_id or bot_id
  winnerParticipantId String? @unique @map("winner_participant_id")

  roundCount Int @default(0) @map("round_count")
  maxRounds  Int @default(30) @map("max_rounds") // автопобеда если превышено

  // Anti-abuse flags
  isSuspicious    Boolean @default(false) @map("is_suspicious")
  suspicionReason String? @map("suspicion_reason")

  // PvP level range (кто может присоединиться)
  levelMin Int @default(1) @map("level_min")
  levelMax Int @default(99) @map("level_max")

  // Заявка на бой (правка заказчика, октябрь 2026): бой не открывается сразу,
  // а висит в общем списке до startsAt — к нему присоединяются, потом он
  // стартует сам. teamSize — бойцов на сторону, isChaotic — стороны
  // делятся жребием при старте.
  startsAt  DateTime? @map("starts_at")
  teamSize  Int?      @map("team_size")
  isChaotic Boolean   @default(false) @map("is_chaotic")
  creatorId String?   @map("creator_id")

  // Redis key for live state (not stored in DB during battle)
  // battle:{id}:state — in Redis
  // battle:{id}:lock  — distributed lock in Redis

  // Timing
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  participants      BattleParticipant[]
  winnerParticipant BattleParticipant?  @relation("BattleWinner", fields: [winnerParticipantId], references: [id])
  turns             BattleTurn[]
  territoryClaim    TerritoryClaim?

  @@index([status])
  @@index([createdAt])
  @@index([status, startsAt])
  @@map("battles")
}

model BattleParticipant {
  id          String  @id @default(uuid())
  battleId    String  @map("battle_id")
  characterId String? @map("character_id") // null если бот
  botId       String? @map("bot_id") // null если игрок
  side        Int     @default(1) // 1 или 2 для клановых боёв

  // Snapshot at battle start
  hpMax     Int @map("hp_max")
  hpCurrent Int @map("hp_current")

  isAlive       Boolean @default(true) @map("is_alive")
  isSurrendered Boolean @default(false) @map("is_surrendered")

  // Stats
  damageDealt    Int @default(0) @map("damage_dealt")
  damageReceived Int @default(0) @map("damage_received")
  hitsLanded     Int @default(0) @map("hits_landed")
  hitsTaken      Int @default(0) @map("hits_taken")
  critLanded     Int @default(0) @map("crit_landed")
  expGained      Int @default(0) @map("exp_gained")
  moneyGained    Int @default(0) @map("money_gained")

  createdAt DateTime @default(now()) @map("created_at")

  battle    Battle     @relation(fields: [battleId], references: [id], onDelete: Cascade)
  wonBattle Battle?    @relation("BattleWinner")
  character Character? @relation(fields: [characterId], references: [id])
  bot       Bot?       @relation(fields: [botId], references: [id])

  @@unique([battleId, characterId])
  @@index([battleId])
  @@index([characterId])
  @@map("battle_participants")
}

model BattleTurn {
  id          String @id @default(uuid())
  battleId    String @map("battle_id")
  roundNumber Int    @map("round_number")

  // Actor (character or bot)
  actorCharId String? @map("actor_char_id")
  actorBotId  String? @map("actor_bot_id")

  // Target
  targetCharId String? @map("target_char_id")
  targetBotId  String? @map("target_bot_id")

  action     BattleAction
  weaponId   String?      @map("weapon_id") // ItemInstance used
  sourceHand AttackHand?  @map("source_hand")

  // Tactical grid movement
  fromX Int? @map("from_x")
  fromY Int? @map("from_y")
  toX   Int? @map("to_x")
  toY   Int? @map("to_y")

  // Zonal combat
  zone         BodyZone? // зона удара
  blockPierced Boolean   @default(false) @map("block_pierced") // удачный удар пробил блок

  // Results
  hit   Boolean @default(false)
  dodge Boolean @default(false)
  block Boolean @default(false)
  crit  Boolean @default(false)

  rawDamage   Int @default(0) @map("raw_damage")
  finalDamage Int @default(0) @map("final_damage")

  // HP tracking
  targetHpBefore Int @default(0) @map("target_hp_before")
  targetHpAfter  Int @default(0) @map("target_hp_after")

  // Durability
  weaponDurLoss Int @default(0) @map("weapon_dur_loss")
  armorDurLoss  Int @default(0) @map("armor_dur_loss")

  // Weapon skill exp gained this turn
  weaponSkillExp Float @default(0) @map("weapon_skill_exp")

  // Human readable log line for frontend
  logLine String? @map("log_line")

  // Боевой помощник: ходил сам или принял удар по хозяину на себя.
  actorHelperId  String? @map("actor_helper_id")
  targetHelperId String? @map("target_helper_id")
  /// Собака хозяина укусила цель (правка заказчика 22.10).
  actorPetId     String? @map("actor_pet_id")

  createdAt DateTime @default(now()) @map("created_at")

  battle Battle        @relation(fields: [battleId], references: [id], onDelete: Cascade)
  weapon ItemInstance? @relation("TurnWeapon", fields: [weaponId], references: [id])

  @@index([battleId, roundNumber])
  @@map("battle_turns")
}

// =============================================================
// WEAPON SKILLS (отдельная прогрессия по типу оружия)
// =============================================================

model WeaponSkill {
  id          String     @id @default(uuid())
  characterId String     @map("character_id")
  weaponType  WeaponType @map("weapon_type")

  skillLevel Int   @default(1) @map("skill_level")
  skillExp   Float @default(0) @map("skill_exp")

  // Anti-mastery (защита от типа оружия, растёт после 20 уровня)
  antiSkillLevel Int   @default(0) @map("anti_skill_level")
  antiSkillExp   Float @default(0) @map("anti_skill_exp")

  // Premium multiplier (задел этап 4)
  premiumMultiplier Float @default(1.0) @map("premium_multiplier")

  updatedAt DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, weaponType])
  @@index([characterId])
  @@map("weapon_skills")
}

// =============================================================
// LOGS
// =============================================================

model FarmPlot {
  id            String        @id @default(uuid())
  characterId   String        @map("character_id")
  slot          Int
  cropCode      String?       @map("crop_code")
  plantedAt     DateTime?     @map("planted_at")
  readyAt       DateTime?     @map("ready_at")
  withersAt     DateTime?     @map("withers_at")
  waterCount    Int           @default(0) @map("water_count")
  lastWateredAt DateTime?     @map("last_watered_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  character     Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  building      FarmBuilding?

  @@unique([characterId, slot])
  @@index([characterId])
  @@index([readyAt])
  @@map("farm_plots")
}

model FarmBuilding {
  id        String           @id @default(uuid())
  plotId    String           @unique @map("plot_id")
  type      FarmBuildingType
  createdAt DateTime         @default(now()) @map("created_at")
  plot      FarmPlot         @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([type])
  @@map("farm_buildings")
}

model Clan {
  id              String            @id @default(uuid())
  name            String            @unique
  tag             String            @unique
  /// Иконка бригады (загружает глава): PNG/JPEG/WebP до 100 КБ, base64.
  iconData        String?           @map("icon_data")
  iconMime        String?           @map("icon_mime")
  /// Растёт при каждой замене — адрес картинки меняется, кэш браузера не мешает.
  iconVersion     Int               @default(0) @map("icon_version")
  level           Int               @default(0)
  treasury        Int               @default(0)
  maintenanceDebt Int               @default(0) @map("maintenance_debt")
  isFrozen        Boolean           @default(false) @map("is_frozen")
  lastChargedAt   DateTime          @default(now()) @map("last_charged_at")
  /// Дом бригады (осады, как замки кланов в «Королях»): прочность падает
  /// после взятия; при 50% и ниже бонусы района выключены до ремонта.
  houseDurability Int               @default(100) @map("house_durability")
  /// Дом разгромлен: бонусы выключены, на стене пишут гости.
  houseRazedUntil DateTime?         @map("house_razed_until")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  roles           ClanRole[]
  members         ClanMember[]
  invites         ClanInvite[]
  storage         ClanStorage[]
  treasuryLogs    ClanTreasuryLog[]
  relationsFrom   ClanRelation[]    @relation("ClanRelationFrom")
  relationsTo     ClanRelation[]    @relation("ClanRelationTo")
  territories     Territory[]

  // Этап 4. Авторитет — валюта войны: не покупается, не передаётся, не
  // конвертируется в рубли. Дробный намеренно: смена даёт 0.2, и целое
  // поле округлило бы её в ноль, отрезав малым кланам главный источник.
  // Текущее значение хранится здесь, а не считается из журнала: оно
  // проверяется при каждой заявке и каждой атаке.
  authority       Float              @default(0)
  territoryLimit  Int                @default(1) @map("territory_limit")
  authorityLogs   ClanAuthorityLog[]
  claimsAttacking TerritoryClaim[]   @relation("ClaimAttacker")
  claimsDefending TerritoryClaim[]   @relation("ClaimDefender")
  attacksMade     ObjectAttack[]     @relation("AttackAttacker")
  attacksSuffered ObjectAttack[]     @relation("AttackDefender")

  @@map("clans")
}

model ClanRole {
  id          String       @id @default(uuid())
  clanId      String       @map("clan_id")
  code        String
  name        String
  rank        Int
  permissions Json
  clan        Clan         @relation(fields: [clanId], references: [id], onDelete: Cascade)
  members     ClanMember[]

  @@unique([clanId, code])
  @@map("clan_roles")
}

model ClanMember {
  id                 String           @id @default(uuid())
  clanId             String           @map("clan_id")
  characterId        String           @unique @map("character_id")
  roleId             String           @map("role_id")
  status             ClanMemberStatus @default(ACTIVE)
  joinedAt           DateTime         @default(now()) @map("joined_at")
  leftAt             DateTime?        @map("left_at")
  storageWithdrawnAt DateTime?        @map("storage_withdrawn_at")
  storageWithdrawn   Int              @default(0) @map("storage_withdrawn")
  treasurySpentAt    DateTime?        @map("treasury_spent_at")
  treasurySpent      Int              @default(0) @map("treasury_spent")
  clan               Clan             @relation(fields: [clanId], references: [id], onDelete: Cascade)
  role               ClanRole         @relation(fields: [roleId], references: [id])

  @@index([clanId, status])
  @@map("clan_members")
}

model ClanInvite {
  id          String           @id @default(uuid())
  clanId      String           @map("clan_id")
  characterId String           @map("character_id")
  invitedById String           @map("invited_by_id")
  status      ClanInviteStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  clan        Clan             @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, characterId, status])
  @@index([characterId, status])
  @@map("clan_invites")
}

model ClanStorage {
  id           String   @id @default(uuid())
  clanId       String   @map("clan_id")
  resourceCode String   @map("resource_code")
  amount       Int      @default(0)
  updatedAt    DateTime @updatedAt @map("updated_at")
  clan         Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, resourceCode])
  @@map("clan_storage")
}

model ClanTreasuryLog {
  id           String   @id @default(uuid())
  clanId       String   @map("clan_id")
  characterId  String?  @map("character_id")
  amount       Int
  balanceAfter Int      @map("balance_after")
  reason       String
  createdAt    DateTime @default(now()) @map("created_at")
  clan         Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId, createdAt])
  @@map("clan_treasury_logs")
}

model ClanRelation {
  id         String           @id @default(uuid())
  fromClanId String           @map("from_clan_id")
  toClanId   String           @map("to_clan_id")
  type       ClanRelationType
  confirmed  Boolean          @default(false)
  updatedAt  DateTime         @updatedAt @map("updated_at")
  fromClan   Clan             @relation("ClanRelationFrom", fields: [fromClanId], references: [id], onDelete: Cascade)
  toClan     Clan             @relation("ClanRelationTo", fields: [toClanId], references: [id], onDelete: Cascade)

  @@unique([fromClanId, toClanId])
  @@map("clan_relations")
}

model ProductionObject {
  id                      String                      @id @default(uuid())
  code                    String                      @unique
  name                    String
  type                    ProductionObjectType
  status                  ProductionObjectStatus      @default(ACTIVE)
  ownerType               OwnerType                   @default(SYSTEM) @map("owner_type")
  ownerCharacterId        String?                     @map("owner_character_id")
  ownerClanId             String?                     @map("owner_clan_id")
  locationId              String?                     @map("location_id")
  level                   Int                         @default(1)
  workerSlots             Int                         @default(10) @map("worker_slots")
  shiftDurationMinutes    Int                         @map("shift_duration_minutes")
  baseSalary              Int                         @map("base_salary")
  baseProductionExp       Int                         @map("base_production_exp")
  requiredProductionLevel Int                         @default(0) @map("required_production_level") // legacy aggregate only
  requiredProfessionCode  String                      @default("scrap_collector") @map("required_profession_code")
  requiredProfessionLevel Int                         @default(0) @map("required_profession_level")
  producesResourceCode    String?                     @map("produces_resource_code")
  outputAmountMin         Int                         @default(0) @map("output_amount_min")
  outputAmountMax         Int                         @default(0) @map("output_amount_max")
  economicExpReward       Int                         @default(0) @map("economic_exp_reward")
  balance                 Int                         @default(0)
  purchasePrice           Int?                        @map("purchase_price")
  /// Сколько $ заплатил нынешний владелец. NULL — куплен за рубли до 28.10,
  /// такому владельцу выкуп остаётся рублёвым.
  paidUsd                 Int?                        @map("paid_usd")
  isForSale               Boolean                     @default(false) @map("is_for_sale")
  salaryOverride          Int?                        @map("salary_override")
  maintenanceDebt         Int                         @default(0) @map("maintenance_debt")
  durabilityCurrent       Int                         @default(100) @map("durability_current")
  durabilityMax           Int                         @default(100) @map("durability_max")
  isActive                Boolean                     @default(true) @map("is_active")
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  shifts                  WorkShift[]
  logs                    ProductionLog[]
  equipment               ProductionEquipment?
  storageCapacity         Int                         @default(0) @map("storage_capacity")
  activeRecipeId          String?                     @map("active_recipe_id")
  pendingRecipeId         String?                     @map("pending_recipe_id")
  profileSwitchEndsAt     DateTime?                   @map("profile_switch_ends_at")
  inventory               ProductionObjectInventory[]
  cycles                  ProductionCycle[]
  barOffers               BarOffer[]
  attacks                 ObjectAttack[]

  // Индекс создан руками миграцией stage3_equipment_profile, но в схеме
  // объявлен не был: Prisma видела дрейф и норовила снести его первой же
  // следующей миграцией. По нему ходит воркер смены профиля — без индекса
  // он бы тихо перешёл на полный перебор объектов.
  @@index([profileSwitchEndsAt])
  @@map("production_objects")
}

model ProductionRecipe {
  id                      String                  @id @default(uuid())
  code                    String                  @unique
  name                    String
  productionObjectCode    String                  @map("production_object_code")
  outputResourceCode      String?                 @map("output_resource_code")
  outputItemTemplateCode  String?                 @map("output_item_template_code")
  outputAmount            Int                     @default(1) @map("output_amount")
  cycleMinutes            Int                     @map("cycle_minutes")
  laborRequired           Int                     @map("labor_required")
  requiredProfessionCode  String                  @map("required_profession_code")
  requiredProfessionLevel Int                     @default(0) @map("required_profession_level")
  requiredToolTier        Int                     @default(1) @map("required_tool_tier")
  isActive                Boolean                 @default(true) @map("is_active")
  createdAt               DateTime                @default(now()) @map("created_at")
  inputs                  ProductionRecipeInput[]
  cycles                  ProductionCycle[]

  @@index([productionObjectCode])
  @@map("production_recipes")
}

model ProductionRecipeInput {
  id           String           @id @default(uuid())
  recipeId     String           @map("recipe_id")
  resourceCode String           @map("resource_code")
  amount       Int
  minQuality   ResourceQuality  @default(POOR) @map("min_quality")
  recipe       ProductionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, resourceCode])
  @@map("production_recipe_inputs")
}

model ProductionObjectInventory {
  id                 String                  @id @default(uuid())
  productionObjectId String                  @map("production_object_id")
  resourceCode       String                  @map("resource_code")
  quality            ResourceQuality         @default(NORMAL)
  amount             Int                     @default(0)
  reservedAmount     Int                     @default(0) @map("reserved_amount")
  updatedAt          DateTime                @updatedAt @map("updated_at")
