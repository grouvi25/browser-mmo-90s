// =============================================================
// PRISMA SCHEMA — Browser MMO 90s
// Этап 1: боевое ядро
// Все таблицы по мастер-ТЗ раздел 15
// =============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// ENUMS
// =============================================================

enum UserStatus {
  ACTIVE
  BANNED
  MUTED
  PENDING_EMAIL
}

enum CharacterStatus {
  ACTIVE
  IN_BATTLE
  WORKING
  TRAVELLING
  RECOVERING
  BANNED
  OFFLINE
}

enum CharacterArchetype {
  ATHLETE // Спортсмен   — +STR +END
  WORKER // Работяга    — +STR +END
  SHUTTLE // Челнок      — +ACC +LUCK
  VETERAN // Бывший срочник — +REA +ACC
  STREET // Уличный     — +AGI +AGR
  MERCHANT // Коммерсант  — +LUCK +AUTH
  STUDENT // Студент     — универсальный
  RESOLVER // Решала      — +AUTH
}

enum ItemType {
  WEAPON
  ARMOR
  SHIELD // щит / защитное снаряжение для правой руки
  ACCESSORY
  CONSUMABLE
  RESOURCE
  COMPONENT
  UPGRADE_MODULE
  TOOL
  SEED
  CROP
}

enum WeaponType {
  MELEE // Рукопашка
  KNIFE // Ножи
  CLUB // Дубинки / арматура
  PISTOL // Пистолеты
  SHOTGUN // Дробовики
  SMG // Пистолеты-пулемёты
  RIFLE // Автоматы
  SNIPER // Винтовки
  HEAVY // Тяжёлое
  THROWN // Метательное / взрывчатка
}

enum ArmorSlot {
  HEAD
  CHEST
  LEGS
  FEET
  HANDS // оставляем для совместимости (старые предметы → GLOVES при рефакторинге)
  LEFT_HAND // основное оружие (новый слот)
  RIGHT_HAND // щит или доп. оружие
  GLOVES // перчатки (заменяет HANDS для новых предметов)
  BELT
  BACK
  POCKET
  ACCESSORY
}

enum ItemQuality {
  JUNK // Хлам
  COMMON // Обычный
  GOOD // Хороший
  RARE // Редкий
  NAMED // Именной
  UNIQUE // Уникальный
}

enum ItemStatus {
  NORMAL
  EQUIPPED
  BROKEN
  LOCKED
  ON_MARKET
  IN_STORAGE
  IN_REPAIR
