}

model FarmBuilding {
  id        String           @id @default(uuid())
  plotId    String           @unique @map("plot_id")
  type      FarmBuildingType
  createdAt DateTime         @default(now()) @map("created_at")
  plot      FarmPlot         @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([type])
  @@map("farm_buildings")
}

model Clan {
  id              String          @id @default(uuid())
  name            String          @unique
  tag             String          @unique
  level           Int             @default(0)
  treasury        Int             @default(0)
  maintenanceDebt Int             @default(0) @map("maintenance_debt")
  isFrozen        Boolean         @default(false) @map("is_frozen")
  lastChargedAt   DateTime        @default(now()) @map("last_charged_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  roles           ClanRole[]
  members         ClanMember[]
  invites         ClanInvite[]
  storage         ClanStorage[]
  treasuryLogs    ClanTreasuryLog[]
  relationsFrom   ClanRelation[]  @relation("ClanRelationFrom")
  relationsTo     ClanRelation[]  @relation("ClanRelationTo")

  @@map("clans")
}

model ClanRole {
  id          String       @id @default(uuid())
  clanId      String       @map("clan_id")
  code        String
  name        String
  rank        Int
  permissions Json
  clan        Clan         @relation(fields: [clanId], references: [id], onDelete: Cascade)
  members     ClanMember[]

  @@unique([clanId, code])
  @@map("clan_roles")
}

model ClanMember {
  id                 String           @id @default(uuid())
  clanId             String           @map("clan_id")
  characterId        String           @unique @map("character_id")
  roleId             String           @map("role_id")
  status             ClanMemberStatus @default(ACTIVE)
  joinedAt           DateTime         @default(now()) @map("joined_at")
  leftAt             DateTime?        @map("left_at")
  storageWithdrawnAt DateTime?        @map("storage_withdrawn_at")
  storageWithdrawn   Int              @default(0) @map("storage_withdrawn")
  treasurySpentAt    DateTime?        @map("treasury_spent_at")
  treasurySpent      Int              @default(0) @map("treasury_spent")
  clan               Clan             @relation(fields: [clanId], references: [id], onDelete: Cascade)
  role               ClanRole         @relation(fields: [roleId], references: [id])

  @@index([clanId, status])
  @@map("clan_members")
}

model ClanInvite {
  id          String           @id @default(uuid())
  clanId      String           @map("clan_id")
  characterId String           @map("character_id")
  invitedById String           @map("invited_by_id")
  status      ClanInviteStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  clan        Clan             @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, characterId, status])
  @@index([characterId, status])
  @@map("clan_invites")
}

model ClanStorage {
  id           String   @id @default(uuid())
  clanId       String   @map("clan_id")
  resourceCode String   @map("resource_code")
  amount       Int      @default(0)
  updatedAt    DateTime @updatedAt @map("updated_at")
  clan         Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@unique([clanId, resourceCode])
  @@map("clan_storage")
}

model ClanTreasuryLog {
  id          String   @id @default(uuid())
  clanId      String   @map("clan_id")
  characterId String?  @map("character_id")
  amount      Int
  balanceAfter Int     @map("balance_after")
  reason      String
  createdAt   DateTime @default(now()) @map("created_at")
  clan        Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId, createdAt])
  @@map("clan_treasury_logs")
}

model ClanRelation {
  id         String           @id @default(uuid())
  fromClanId String           @map("from_clan_id")
  toClanId   String           @map("to_clan_id")
  type       ClanRelationType
  confirmed  Boolean          @default(false)
  updatedAt  DateTime         @updatedAt @map("updated_at")
  fromClan   Clan             @relation("ClanRelationFrom", fields: [fromClanId], references: [id], onDelete: Cascade)
  toClan     Clan             @relation("ClanRelationTo", fields: [toClanId], references: [id], onDelete: Cascade)

  @@unique([fromClanId, toClanId])
  @@map("clan_relations")
}

model ProductionObject {
  id                      String                      @id @default(uuid())
  code                    String                      @unique
  name                    String
  type                    ProductionObjectType
  status                  ProductionObjectStatus      @default(ACTIVE)
  ownerType               OwnerType                   @default(SYSTEM) @map("owner_type")
  ownerCharacterId        String?                     @map("owner_character_id")
  ownerClanId             String?                     @map("owner_clan_id")
  locationId              String?                     @map("location_id")
  level                   Int                         @default(1)
  workerSlots             Int                         @default(10) @map("worker_slots")
  shiftDurationMinutes    Int                         @map("shift_duration_minutes")
  baseSalary              Int                         @map("base_salary")
  baseProductionExp       Int                         @map("base_production_exp")
  requiredProductionLevel Int                         @default(0) @map("required_production_level") // legacy aggregate only
  requiredProfessionCode  String                      @default("scrap_collector") @map("required_profession_code")
  requiredProfessionLevel Int                         @default(0) @map("required_profession_level")
  producesResourceCode    String?                     @map("produces_resource_code")
  outputAmountMin         Int                         @default(0) @map("output_amount_min")
  outputAmountMax         Int                         @default(0) @map("output_amount_max")
  economicExpReward       Int                         @default(0) @map("economic_exp_reward")
  balance                 Int                         @default(0)
  purchasePrice           Int?                        @map("purchase_price")
  isForSale               Boolean                     @default(false) @map("is_for_sale")
  salaryOverride          Int?                        @map("salary_override")
  maintenanceDebt         Int                         @default(0) @map("maintenance_debt")
  durabilityCurrent       Int                         @default(100) @map("durability_current")
  durabilityMax           Int                         @default(100) @map("durability_max")
  isActive                Boolean                     @default(true) @map("is_active")
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  shifts                  WorkShift[]
  logs                    ProductionLog[]
  equipment               ProductionEquipment?
  storageCapacity         Int                         @default(0) @map("storage_capacity")
  activeRecipeId          String?                     @map("active_recipe_id")
  pendingRecipeId         String?                     @map("pending_recipe_id")
  profileSwitchEndsAt     DateTime?                   @map("profile_switch_ends_at")
  inventory               ProductionObjectInventory[]
  cycles                  ProductionCycle[]
  barOffers               BarOffer[]

  @@map("production_objects")
}

model ProductionRecipe {
  id                      String                  @id @default(uuid())
  code                    String                  @unique
  name                    String
  productionObjectCode    String                  @map("production_object_code")
  outputResourceCode      String?                 @map("output_resource_code")
  outputItemTemplateCode  String?                 @map("output_item_template_code")
  outputAmount            Int                     @default(1) @map("output_amount")
  cycleMinutes            Int                     @map("cycle_minutes")
  laborRequired           Int                     @map("labor_required")
  requiredProfessionCode  String                  @map("required_profession_code")
  requiredProfessionLevel Int                     @default(0) @map("required_profession_level")
  requiredToolTier        Int                     @default(1) @map("required_tool_tier")
  isActive                Boolean                 @default(true) @map("is_active")
  createdAt               DateTime                @default(now()) @map("created_at")
  inputs                  ProductionRecipeInput[]
  cycles                  ProductionCycle[]

  @@index([productionObjectCode])
  @@map("production_recipes")
}

model ProductionRecipeInput {
  id           String           @id @default(uuid())
  recipeId     String           @map("recipe_id")
  resourceCode String           @map("resource_code")
  amount       Int
  minQuality   ResourceQuality  @default(POOR) @map("min_quality")
  recipe       ProductionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, resourceCode])
  @@map("production_recipe_inputs")
}

model ProductionObjectInventory {
  id                 String                  @id @default(uuid())
  productionObjectId String                  @map("production_object_id")
  resourceCode       String                  @map("resource_code")
  quality            ResourceQuality         @default(NORMAL)
  amount             Int                     @default(0)
  reservedAmount     Int                     @default(0) @map("reserved_amount")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  productionObject   ProductionObject        @relation(fields: [productionObjectId], references: [id], onDelete: Cascade)
  cycleReservations  CycleInputReservation[]

  @@unique([productionObjectId, resourceCode, quality])
  @@index([productionObjectId])
  @@map("production_object_inventory")
}

model ProductionCycle {
  id                 String                   @id @default(uuid())
  productionObjectId String                   @map("production_object_id")
  recipeId           String                   @map("recipe_id")
  status             ProductionCycleStatus    @default(PENDING)
  laborRequired      Int                      @map("labor_required")
  laborAccumulated   Int                      @default(0) @map("labor_accumulated")
  startedAt          DateTime?                @map("started_at")
  endsAt             DateTime?                @map("ends_at")
  completedAt        DateTime?                @map("completed_at")
  failureReason      ProductionCycleFailure?  @map("failure_reason")
  outputQuality      ResourceQuality?         @map("output_quality")
  createdAt          DateTime                 @default(now()) @map("created_at")
  productionObject   ProductionObject         @relation(fields: [productionObjectId], references: [id], onDelete: Cascade)
  recipe             ProductionRecipe         @relation(fields: [recipeId], references: [id])
  contributions      CycleLaborContribution[]
  inputReservations  CycleInputReservation[]

  @@index([productionObjectId, status])
  @@index([status, endsAt])
  @@map("production_cycles")
}

model CycleInputReservation {
  id           String                    @id @default(uuid())
  cycleId      String                    @map("cycle_id")
  inventoryId  String                    @map("inventory_id")
  resourceCode String                    @map("resource_code")
  quality      ResourceQuality
  amount       Int
  cycle        ProductionCycle           @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  inventory    ProductionObjectInventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@unique([cycleId, inventoryId])
  @@index([cycleId])
  @@map("cycle_input_reservations")
}

model CycleLaborContribution {
  id              String          @id @default(uuid())
  cycleId         String          @map("cycle_id")
  characterId     String          @map("character_id")
  workShiftId     String          @unique @map("work_shift_id")
  laborMinutes    Int             @map("labor_minutes")
  professionLevel Int             @map("profession_level")
  toolTier        Int             @default(0) @map("tool_tier")
  createdAt       DateTime        @default(now()) @map("created_at")
  cycle           ProductionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@index([characterId])
  @@map("cycle_labor_contributions")
}

model ProductionEquipment {
  id                   String           @id @default(uuid())
  productionObjectId   String           @unique @map("production_object_id")
  code                 String           @unique
  name                 String
  tier                 Int              @default(1)
  requiredToolTier     Int              @default(1) @map("required_tool_tier")
  producesResourceCode String?          @map("produces_resource_code")
  isActive             Boolean          @default(true) @map("is_active")
  ownerType            OwnerType        @default(SYSTEM) @map("owner_type")
  ownerCharacterId     String?          @map("owner_character_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  productionObject     ProductionObject @relation(fields: [productionObjectId], references: [id], onDelete: Cascade)

  @@map("production_equipment")
}

model BarOffer {
  id                 String           @id @default(uuid())
  productionObjectId String           @map("production_object_id")
  code               String           @unique
  name               String
  resourceCode       String           @map("resource_code")
  price              Int
  baseCost           Int              @map("base_cost")
  hpRestore          Int              @default(0) @map("hp_restore")
  alcoholDegrees     Int              @default(0) @map("alcohol_degrees")
  accuracyBuff       Float            @default(0) @map("accuracy_buff")
  damageBuff         Float            @default(0) @map("damage_buff")
  buffMinutes        Int              @default(0) @map("buff_minutes")
  isActive           Boolean          @default(true) @map("is_active")
  productionObject   ProductionObject @relation(fields: [productionObjectId], references: [id], onDelete: Cascade)

  @@index([productionObjectId, isActive])
  @@map("bar_offers")
}

model WorkShift {
  id                   String           @id @default(uuid())
  characterId          String           @map("character_id")
  productionObjectId   String           @map("production_object_id")
  status               WorkShiftStatus  @default(ACTIVE)
  startedAt            DateTime         @map("started_at")
  endsAt               DateTime         @map("ends_at")
  claimedAt            DateTime?        @map("claimed_at")
  baseSalary           Int              @map("base_salary")
  finalSalary          Int?             @map("final_salary")
  productionExpReward  Int?             @map("production_exp_reward") // legacy field
  toolInstanceId       String?          @map("tool_instance_id")
  professionCode       String           @default("scrap_collector") @map("profession_code")
  professionExpReward  Int?             @map("profession_exp_reward")
  resourceRewardCode   String?          @map("resource_reward_code")
  resourceRewardAmount Int?             @map("resource_reward_amount")
  failureReason        String?          @map("failure_reason")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  character            Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  productionObject     ProductionObject @relation(fields: [productionObjectId], references: [id])
  toolInstance         ItemInstance?    @relation("WorkShiftTool", fields: [toolInstanceId], references: [id])

  @@index([characterId, status])
  @@index([status, endsAt])
  @@index([toolInstanceId])
  @@map("work_shifts")
}

model ResourceTemplate {
  id                String           @id @default(uuid())
  code              String           @unique
  name              String
  description       String?
  category          ResourceCategory
  tier              Int              @default(1)
  basePrice         Int              @map("base_price")
  weight            Float            @default(0)
  isTradable        Boolean          @default(true) @map("is_tradable")
  isRepairMaterial  Boolean          @default(false) @map("is_repair_material")
  isUpgradeMaterial Boolean          @default(false) @map("is_upgrade_material")
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at")
  stacks            ResourceStack[]

  @@map("resource_templates")
}

model ResourceStack {
  id                 String           @id @default(uuid())
  characterId        String           @map("character_id")
  resourceTemplateId String           @map("resource_template_id")
  amount             Int              @default(0)
  reservedAmount     Int              @default(0) @map("reserved_amount")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  character          Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  template           ResourceTemplate @relation(fields: [resourceTemplateId], references: [id])

  @@unique([characterId, resourceTemplateId])
  @@index([characterId])
  @@map("resource_stacks")
}

model PrivateShopItem {
  id                 String    @id @default(uuid())
  shopCode           String    @map("shop_code")
  itemTemplateId     String?   @map("item_template_id")
  resourceTemplateId String?   @map("resource_template_id")
  price              Int
  stockMode          StockMode @default(INFINITE) @map("stock_mode")
  stockAmount        Int?      @map("stock_amount")
  minBattleLevel     Int       @default(0) @map("min_battle_level")
  minEconomicLevel   Int       @default(0) @map("min_economic_level")
  minProductionLevel Int       @default(0) @map("min_production_level") // legacy aggregate only
  minProfessionCode  String?   @map("min_profession_code")
  minProfessionLevel Int       @default(0) @map("min_profession_level")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@unique([shopCode, itemTemplateId])
  @@unique([shopCode, resourceTemplateId])
  @@index([shopCode, isActive])
  @@map("private_shop_items")
}

model MarketListing {
  id                 String              @id @default(uuid())
  sellerCharacterId  String              @map("seller_character_id")
  buyerCharacterId   String?             @map("buyer_character_id")
  type               MarketListingType
  status             MarketListingStatus @default(ACTIVE)
  itemInstanceId     String?             @map("item_instance_id")
  resourceTemplateId String?             @map("resource_template_id")
  resourceAmount     Int?                @map("resource_amount")
  price              Int
  listingFee         Int                 @map("listing_fee")
  saleTax            Int?                @map("sale_tax")
  expiresAt          DateTime            @map("expires_at")
  soldAt             DateTime?           @map("sold_at")
  createdAt          DateTime            @default(now()) @map("created_at")

  @@index([status, expiresAt])
  @@index([sellerCharacterId, status])
  @@map("market_listings")
}

model UpgradeLog {
  id                 String           @id @default(uuid())
  characterId        String           @map("character_id")
  itemInstanceId     String           @map("item_instance_id")
  upgradeType        UpgradeType      @map("upgrade_type")
  levelBefore        Int              @map("level_before")
  levelAfter         Int              @map("level_after")
  cost               Int
  successChance      Float            @map("success_chance")
  result             UpgradeLogResult
  resourcesSpentJson Json?            @map("resources_spent_json")
  resultCode         String           @map("result_code")
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([characterId, createdAt])
  @@map("upgrade_logs")
}

model ProductionLog {
  id                 String             @id @default(uuid())
  characterId        String?            @map("character_id")
  productionObjectId String             @map("production_object_id")
  eventType          ProductionLogEvent @map("event_type")
  metadataJson       Json?              @map("metadata_json")
  createdAt          DateTime           @default(now()) @map("created_at")
  productionObject   ProductionObject   @relation(fields: [productionObjectId], references: [id])

  @@index([productionObjectId, createdAt])
  @@map("production_logs")
}

model ResourceLog {
  id                 String            @id @default(uuid())
  characterId        String            @map("character_id")
  resourceTemplateId String            @map("resource_template_id")
  amountDelta        Int               @map("amount_delta")
  balanceAfter       Int               @map("balance_after")
  reasonCode         ResourceLogReason @map("reason_code")
  refType            String?
  refId              String?           @map("ref_id")
  createdAt          DateTime          @default(now()) @map("created_at")

  @@index([characterId, createdAt])
  @@map("resource_logs")
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  characterId  String   @map("character_id")
  scope        String
  key          String
  responseJson Json     @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@unique([characterId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model CurrencyLog {
  id           String            @id @default(uuid())
  characterId  String            @map("character_id")
  amount       Int // положительный — приход, отрицательный — расход
  balanceAfter Int               @map("balance_after")
  reasonCode   CurrencyLogReason @map("reason_code")
  refId        String?           @map("ref_id") // id связанной сущности (battle_id, item_id, etc.)
  refType      String?           @map("ref_type") // 'battle' | 'item' | 'repair' | 'shop'
  note         String?
  createdAt    DateTime          @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt])
  @@map("currency_logs")
}

model ItemLog {
  id          String        @id @default(uuid())
  itemId      String        @map("item_id")
  characterId String        @map("character_id")
  actionCode  ItemLogAction @map("action_code")
  details     Json? // { before: ..., after: ..., reason: ... }
  createdAt   DateTime      @default(now()) @map("created_at")

  item      ItemInstance @relation(fields: [itemId], references: [id], onDelete: Cascade)
  character Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([characterId, createdAt])
  @@map("item_logs")
}

model RepairLog {
  id               String   @id @default(uuid())
  characterId      String   @map("character_id")
  itemId           String   @map("item_id")
  cost             Int
  durabilityBefore Int      @map("durability_before")
  durabilityAfter  Int      @map("durability_after")
  repairedAt       DateTime @default(now()) @map("repaired_at")

  character Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item      ItemInstance @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([itemId])
  @@map("repair_logs")
}

