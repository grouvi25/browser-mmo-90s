// =============================================================
// ADMIN
// =============================================================

/// Вид сигнала антиабуза. Девять из реестра механик заказчика и пять,
/// которые принёс стратегический слой Этапа 4.
enum AbuseSignalKind {
  MULTI_ACCOUNT
  MATCH_FIXING
  DUPLICATION
  BOT_FARMING
  WEAK_FARMING
  MONEY_FUNNEL
  CLAN_STORAGE_DRAIN
  MARKET_MANIPULATION
  AUTOCLICKER
  HELPER_DRAIN
  OBJECT_TRANSFER_TRAP
  WAR_COLLUSION
  CLAIM_REFUNDED
  ROBBERY_STREAK
}

enum AbuseSignalStatus {
  OPEN
  REVIEWED
  DISMISSED
}

/// Сигнал антиабуза. НЕ наказание: сигнал ничего не делает сам, он
/// показывается администратору, и решает человек (принцип П3 Этапа 5).
model AbuseSignal {
  id       String            @id @default(uuid())
  kind     AbuseSignalKind
  status   AbuseSignalStatus @default(OPEN)
  /// 1..3. Тройка означает «остановить и разобраться», а не «забанить».
  severity Int

  /// Кого касается. Аккаунтов может быть несколько: граф связей находит пары.
  userIds String[] @map("user_ids")

  /// Объяснение словами. Сигнал «подозрительная активность у игрока X»
  /// бесполезен: его нельзя ни проверить, ни отклонить.
  summary String

  /// Числа, на которых сигнал сработал. Без них отклонённый сигнал
  /// невозможно перепроверить, когда правило изменится.
  evidence Json

  /// Ключ повторного срабатывания: один и тот же повод не должен плодить
  /// сигналы каждые сутки, иначе лента алертов станет нечитаемой.
  dedupeKey String @map("dedupe_key")

  reviewedByAdminId String?   @map("reviewed_by_admin_id")
  reviewedAt        DateTime? @map("reviewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([kind, dedupeKey])
  @@index([status, severity, createdAt])
  @@map("abuse_signals")
}

/// Чем связаны два аккаунта. Рёбра взвешены: общий IP весит больше, чем
/// одна сделка на рынке.
enum AccountLinkKind {
  SHARED_IP
  MARKET_TRADE
  SAME_CLAN
}

/// Ребро графа связей аккаунтов.
///
/// Хранятся именно рёбра, а не готовые кластеры: правила кластеризации будут
/// меняться, а сырые связи останутся верными.
///
/// Ребро неориентированное, поэтому в userAId всегда лексикографически
/// меньший id — иначе одна пара завелась бы дважды.
model AccountLink {
  id       String          @id @default(uuid())
  userAId  String          @map("user_a_id")
  userBId  String          @map("user_b_id")
  kind     AccountLinkKind
  weight   Float
  evidence Json

  lastSeenAt DateTime @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userAId, userBId, kind])
  @@index([userAId])
  @@index([userBId])
  @@map("account_links")
}

/// Журнал административных действий с обратной операцией.
///
/// Главная сущность Этапа 5. Без неё админ действует безвозвратно: выдал
/// миллион — миллион в экономике навсегда. Каждая строка знает не только что
/// сделано, но и как это отменить.
model AdminActionLog {
  id        String          @id @default(uuid())
  adminId   String          @map("admin_id")
  /// Роль на момент действия. Роль аккаунта может измениться позже,
  /// история обязана остаться правдивой.
  adminRole AdminRole       @map("admin_role")
  kind      AdminActionKind
  reason    String

  /// Кого затронуло: тип и id. Свободная пара, потому что цели разнородны —
  /// персонаж, предмет, лот, клан, район, заявка, помощник.
  targetType String @map("target_type")
  targetId   String @map("target_id")

  /// Параметры выполненной операции и параметры обратной к ней.
  /// Обратная обязательна: действие без неё не заводится.
  payload     Json
  undoKind    AdminActionKind @map("undo_kind")
  undoPayload Json            @map("undo_payload")

  /// Если это откат — ссылка на отменённое действие. Уникальна: одно
  /// действие нельзя откатить дважды, иначе откат выдачи денег превратился
  /// бы в списание.
  rolledBackId String?   @unique @map("rolled_back_id")
  rolledBackAt DateTime? @map("rolled_back_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_action_logs")
}

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("admin_users")
}

// =============================================================
// ЭТАП 4 — ТЕРРИТОРИИ
//
// Район города как объект владения кланом. Коды совпадают с ключами
// MENU.districts во фронте и с OBJECT_DISTRICTS в сиде: по ним же
// ProductionObject.locationId связывает объект с районом.
// Раскладка и обоснование — docs/specs/stage-4/STAGE4_DATA_MODEL.md.
// =============================================================

enum TerritoryStatus {
  NEUTRAL // ничей
  CONTROLLED // под контролем клана
  CONTESTED // подана заявка, бой назначен
  UNDER_ATTACK // бой идёт
  PROTECTED // защита после захвата
}

model Territory {
  id     String          @id @default(uuid())
  code   String          @unique
  name   String
  status TerritoryStatus @default(NEUTRAL)

  ownerClanId    String?   @map("owner_clan_id")
  controlledAt   DateTime? @map("controlled_at")
  protectedUntil DateTime? @map("protected_until")

  // Бонус района вынесен в данные: подбор бонусов — предмет балансировки,
  // а балансировка не должна требовать выката кода.
  bonusCode  String @map("bonus_code")
  bonusValue Float  @map("bonus_value")

  // Порядковый номер владения у клана: определяет ступень содержания.
  // Пересчитывается при каждой смене владельца.
  upkeepTier Int @default(1) @map("upkeep_tier")
  // Общак пуст — содержание копится долгом, а не отбирает район мгновенно.
  // Тот же приём, что с зарплатой объекта в Этапе 3.
  upkeepDebt Int @default(0) @map("upkeep_debt")

  lastChargedAt DateTime @default(now()) @map("last_charged_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ownerClan Clan?            @relation(fields: [ownerClanId], references: [id])
  claims    TerritoryClaim[]

  @@index([ownerClanId])
  @@index([status])
  @@map("territories")
}

// =============================================================
// ЭТАП 4 — ЗАЯВКИ НА ТЕРРИТОРИЮ И АВТОРИТЕТ
//
// Заявка живёт своей жизнью: подана — ждёт назначенного часа — идёт бой —
// разобран исход. Состав пишется при подаче и переносится в бой дословно,
// чтобы его нельзя было подменить между подачей и началом.
// ТЗ: docs/specs/stage-4/MASTER_TZ_STAGE_4_STRATEGY_PREMIUM_WAR.md, раздел 8.
// =============================================================

enum TerritoryClaimStatus {
  PENDING // подана, ждёт назначенного времени
  BATTLE // бой идёт
  WON // контроль передан
  LOST // оборона выстояла
  CANCELLED // отозвана подавшим
  EXPIRED // сорвалось назначение боя
}

enum ClanAuthorityReason {
  TERRITORY_WON
  TERRITORY_DEFENDED
  TERRITORY_HELD
  CYCLE_COMPLETED
  SHIFT_COMPLETED
  CLAIM_FILED
  CLAIM_REFUNDED
  SABOTAGE_FILED
  ROBBERY_FILED
  ADMIN_ADJUST
}

model TerritoryClaim {
  id                 String  @id @default(uuid())
  territoryId        String  @map("territory_id")
  attackerClanId     String  @map("attacker_clan_id")
  defenderClanId     String? @map("defender_clan_id") // null для ничейной
  filedByCharacterId String  @map("filed_by_character_id")

  status         TerritoryClaimStatus @default(PENDING)
  battleStartsAt DateTime             @map("battle_starts_at")
  battleId       String?              @unique @map("battle_id")

  feePaid        Int
  authoritySpent Float   @map("authority_spent")
  /// Победа без боя: обороняющийся никого не выставил.
  walkover       Boolean @default(false)

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  territory    Territory              @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  attackerClan Clan                   @relation("ClaimAttacker", fields: [attackerClanId], references: [id], onDelete: Cascade)
  defenderClan Clan?                  @relation("ClaimDefender", fields: [defenderClanId], references: [id])
  battle       Battle?                @relation(fields: [battleId], references: [id])
  roster       TerritoryClaimRoster[]

  @@index([territoryId, status])
  @@index([attackerClanId])
  @@index([status, battleStartsAt])
  @@map("territory_claims")
}

model TerritoryClaimRoster {
  id          String @id @default(uuid())
  claimId     String @map("claim_id")
  characterId String @map("character_id")
  /// 1 — атакующий клан, 2 — обороняющийся. Совпадает с
  /// BattleParticipant.side: состав переносится в бой один в один.
  side        Int
  /// Вес бойца на момент записи. Проверка «пять от третьего уровня»
  /// смотрит сюда, иначе заявку закрывают прокачанными, а приводят альтов.
  battleLevel Int    @map("battle_level")

  createdAt DateTime @default(now()) @map("created_at")

  claim     TerritoryClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  character Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([claimId, characterId])
  @@index([claimId, side])
  @@map("territory_claim_rosters")
}

model ClanAuthorityLog {
  id           String              @id @default(uuid())
  clanId       String              @map("clan_id")
  amount       Float
  reason       ClanAuthorityReason
  /// Свободная ссылка на источник: заявка, цикл, смена, атака.
  refId        String?             @map("ref_id")
  /// Остаток после операции — по нему сверяется поле Clan.authority.
  balanceAfter Float               @map("balance_after")

  createdAt DateTime @default(now()) @map("created_at")

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId, createdAt])
  @@map("clan_authority_logs")
}

// =============================================================
// ЭТАП 4 — БОИ ЗА ОБЪЕКТЫ
//
// Объект нельзя разрушить насовсем. Можно повредить (диверсия) или снять
// долю с баланса (ограбление). Основание — разведка GanjaWars: война
// обязана двигать экономические потоки, но не стирать прогресс игрока.
// Повреждённый объект чинится восстановительными работами Этапа 3 с
// тройным опытом профессии, то есть война создаёт работу.
//
// ТЗ: docs/specs/stage-4/MASTER_TZ_STAGE_4_STRATEGY_PREMIUM_WAR.md, часть III.
// =============================================================

enum ObjectAttackType {
  SABOTAGE // прочность и простой
  ROBBERY // доля баланса
}

model ObjectAttack {
  id                 String  @id @default(uuid())
  objectId           String  @map("object_id")
  attackerClanId     String  @map("attacker_clan_id")
  defenderClanId     String? @map("defender_clan_id")
  filedByCharacterId String  @map("filed_by_character_id")

  type ObjectAttackType

  /// Диверсия: сколько прочности снято. Ограбление: 0.
  durabilityLost   Int     @default(0) @map("durability_lost")
  /// Ограбление: сколько рублей ушло в общак атакующего. Диверсия: 0.
  moneyTaken       Int     @default(0) @map("money_taken")
  /// Отменённый диверсией цикл, если он был. Сырьё по нему возвращено.
  cancelledCycleId String? @map("cancelled_cycle_id")

  authoritySpent Float    @map("authority_spent")
  createdAt      DateTime @default(now()) @map("created_at")

  object       ProductionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  attackerClan Clan             @relation("AttackAttacker", fields: [attackerClanId], references: [id], onDelete: Cascade)
  defenderClan Clan?            @relation("AttackDefender", fields: [defenderClanId], references: [id])

  // Кулдаун в 72 часа считается запросом по этому индексу, а не отдельным
  // полем на объекте: поле пришлось бы чистить, индекс — нет.
  @@index([objectId, createdAt])
  @@index([attackerClanId, createdAt])
  @@map("object_attacks")
}

// =============================================================
// ЭТАП 4 — PREMIUM И ПОМОЩНИКИ
//
// Главное правило этапа: премиум продаёт ВРЕМЯ, а не силу. Ни один товар
// витрины не выдаёт предмет с ненулевым бюджетом статов — это проверяется
// машинно, а не декларируется.
// ТЗ: docs/specs/stage-4/MASTER_TZ_STAGE_4_STRATEGY_PREMIUM_WAR.md, часть VI.
// =============================================================

enum PremiumProductKind {
  TIME // ускоряет то, чего можно дождаться
  COSMETIC // на механику не влияет вообще
  CONVENIENCE // удобство, на бой не влияет
}

/// Правка заказчика 21.10: помощников два — боевой и рабочий или два
/// рабочих; двух боевых нельзя.
enum HelperKind {
  WORK
  COMBAT
}

/// Тактика боевого помощника: атакующая бьёт сильнее, защитная чаще
/// принимает удары по хозяину на себя, стандартная — посередине.
enum HelperTactic {
  STANDARD
  DEFENSIVE
  ATTACK
}

enum HelperStatus {
  ACTIVE // подписка активна, работает
  DORMANT // подписки нет, остаётся в профиле
}

model PremiumProduct {
  id           String             @id @default(uuid())
  code         String             @unique
  name         String
  description  String
  kind         PremiumProductKind
  priceRub     Int                @map("price_rub")
  /// Цена в игровых долларах: за неё игрок покупает товар сам.
  priceDollars Int                @default(0) @map("price_dollars")
  /// Что выдаётся: ключ эффекта, разбирается сервисом по закрытому списку.
  grantCode    String             @map("grant_code")
  grantValue   Int                @default(0) @map("grant_value")
  isActive     Boolean            @default(true) @map("is_active")
  sortOrder    Int                @default(0) @map("sort_order")

  purchases PremiumPurchase[]

  @@map("premium_products")
}

model PremiumPurchase {
  id               String  @id @default(uuid())
  /// Покупает персонаж: подписка живёт на нём, а не на аккаунте.
  characterId      String  @map("character_id")
  productId        String  @map("product_id")
  /// Цена копией: в каталоге она меняется, история покупок обязана
  /// остаться неизменной. Тот же приём, что в рыночных сделках Этапа 2.
  priceRub         Int     @map("price_rub")
  /// Сколько долларов списано; 0 — товар выдал администратор.
  priceDollars     Int     @default(0) @map("price_dollars")
  /// Оплата в первой версии вне игры, оформляет администратор.
  grantedByAdminId String? @map("granted_by_admin_id")

  createdAt DateTime @default(now()) @map("created_at")

  character Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  product   PremiumProduct @relation(fields: [productId], references: [id])

  @@index([characterId, createdAt])
  @@map("premium_purchases")
}

model Helper {
  id              String       @id @default(uuid())
  characterId     String       @map("character_id")
  name            String
  kind            HelperKind   @default(WORK)
  /// Боевой помощник (правка 21.10, как бойцовый питомец «Апехи»): дерётся
  /// рядом с хозяином по выбранной тактике и растёт в уровне от боёв.
  tactic          HelperTactic @default(STANDARD)
  combatLevel     Int          @default(1) @map("combat_level")
  combatExp       Float        @default(0) @map("combat_exp")
  status          HelperStatus @default(ACTIVE)
  /// Профессия своя, не хозяйская. Потолок 3 при потолке игрока 6:
  /// помощник никогда не заменит специалиста на верхних переделах.
  professionCode  String       @map("profession_code")
  professionLevel Int          @default(0) @map("profession_level")
  professionExp   Float        @default(0) @map("profession_exp")

  /// Текущая смена, если помощник занят.
  activeShiftId String? @unique @map("active_shift_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  character   Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  activeShift WorkShift? @relation(fields: [activeShiftId], references: [id])

  @@index([characterId])
  @@map("helpers")
}

// =============================================================
// CHAT — «радио»
//
// Один канал на все виды эфира. Комната внутри канала лежит в
// scope: ключ района для DISTRICT, идентификатор клана для CLAN,
// пустая строка для GLOBAL. Так лента, история и права читаются
// одним индексом, а не тремя таблицами.
// =============================================================
enum ChatChannel {
  DISTRICT
  CLAN
  GLOBAL
  /// Личное сообщение: видят только автор и получатель (recipientId).
  PRIVATE
}

enum Gender {
  MALE
  FEMALE
}

model ChatMessage {
  id          String      @id @default(uuid())
  channel     ChatChannel
  scope       String      @default("")
  authorId    String      @map("author_id")
  /// Получатель личного сообщения; у остальных каналов пусто.
  recipientId String?     @map("recipient_id")
  body        String      @db.VarChar(400)
  createdAt   DateTime    @default(now()) @map("created_at")
  // Мягкое удаление: модератор прячет сообщение, но след остаётся —
  // разбирать жалобы по пустому месту невозможно.
  deletedAt   DateTime?   @map("deleted_at")
  deletedBy   String?     @map("deleted_by")

  author Character @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([channel, scope, createdAt])
  @@index([authorId, createdAt])
  @@index([recipientId, createdAt])
  @@map("chat_messages")
}

// =============================================================
// ANNOUNCEMENTS — городские объявления
//
// Вторая половина «Радио»: то, что говорит сам город, а не игроки.
// Три источника в одной ленте, потому что читают её подряд:
//   PATCH — что изменилось в игре (закрывает «Обновления»),
//   NEWS  — от администрации (закрывает «Новости»),
//   WORLD — события мира: захваты территорий, итоги войн бригад.
//
// WORLD пишет сама игра, остальные два — администратор. Поэтому
// автора нет в обязательных полях: у события мира его и не бывает.
// =============================================================
enum AnnouncementKind {
  PATCH
  NEWS
  WORLD
}

model Announcement {
  id          String           @id @default(uuid())
  kind        AnnouncementKind
  title       String           @db.VarChar(120)
  body        String           @db.VarChar(2000)
  // Закреплённое висит сверху ленты, сколько бы нового ни пришло.
  pinned      Boolean          @default(false)
  // Кто написал. Пусто у событий мира — их пишет игра.
  authorLogin String?          @map("author_login")
  createdAt   DateTime         @default(now()) @map("created_at")
  // Мягкое снятие: объявление уходит из ленты, но остаётся в истории.
  removedAt   DateTime?        @map("removed_at")

  @@index([removedAt, pinned, createdAt])
  @@map("announcements")
}

model CharacterPet {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  code        String
  name        String
  food        Int       @default(0)
  fedUntil    DateTime? @map("fed_until")
  /// Правка заказчика 21.10: у собак свои уровни, опыт, очки и снаряжение.
  level       Int       @default(1)
  exp         Int       @default(0)
  /// Распределение очков донатной собаки: { "str": 2, "luck": 1 }.
  allocation  Json?
  /// Снаряжение по слотам: { "MUZZLE": "dog_muzzle_leather", ... }.
  gear        Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, code])
  @@map("character_pets")
}

/// Причина движения игровых долларов.
enum DollarReason {
  ISSUE // администрация выдала (дилеру за оплату или в подарок)
  WITHDRAW // администрация списала (в том числе откат выдачи)
  TRANSFER_OUT // дилер перевёл игроку
  TRANSFER_IN // игрок получил от дилера
  PURCHASE // покупка товара за доллары
  MARKET_SALE // выручка с продажи на рынке за доллары
  MARKET_TAX // налог с такой продажи
  EXCHANGE // обменник Чёрного рынка (знак — направление)
  OBJECT_SALE // выкуп государством объекта, купленного за доллары
  REFERRAL // процент с пополнения приглашённого игрока
  REFERRAL_PAYOUT // заявка на вывод реферальных на карту (возврат при отказе — с плюсом)
}

enum MarketCurrency {
  RUB
  USD
}

/// Журнал игровых долларов. Каждая операция с балансом после неё:
/// по журналу сходится любой счёт, и видно, какой дилер кого пополнил.
model DollarLog {
  id             String       @id @default(uuid())
  characterId    String       @map("character_id")
  amount         Int
  balanceAfter   Int          @map("balance_after")
  reason         DollarReason
  counterpartyId String?      @map("counterparty_id")
  refId          String?      @map("ref_id")
  note           String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([characterId, createdAt])
  @@index([counterpartyId, createdAt])
  @@map("dollar_logs")
}

enum ReferralPayoutStatus {
  PENDING
  PAID
  REJECTED
}

/// Заявка на вывод реферальных на карту. Выплаты ручные (заказчик 28.10):
/// доллары списываются при заявке, администрация переводит рубли сама и
/// отмечает «выплачено»; при отказе доллары возвращаются.
model ReferralPayout {
  id          String               @id @default(uuid())
  characterId String               @map("character_id")
  amount      Int
  details     String
  status      ReferralPayoutStatus @default(PENDING)
  adminNote   String?              @map("admin_note")
  processedBy String?              @map("processed_by")
  processedAt DateTime?            @map("processed_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([characterId, createdAt])
  @@map("referral_payouts")
}

/// Осада дома бригады — правка заказчика, по образцу захвата замков в «Королях».
enum HouseSiegeStatus {
  SCHEDULED // назначена, идёт запись
  IN_BATTLE // бой идёт
  ATTACKERS_WON // дом взят
  DEFENDERS_WON // отбились
  CANCELLED // снята главарём до начала
}

model HouseSiege {
  id                 String           @id @default(uuid())
  attackerClanId     String           @map("attacker_clan_id")
  defenderClanId     String           @map("defender_clan_id")
  filedByCharacterId String           @map("filed_by_character_id")
  startsAt           DateTime         @map("starts_at")
  status             HouseSiegeStatus @default(SCHEDULED)
  battleId           String?          @unique @map("battle_id")
  attackersCount     Int              @default(0) @map("attackers_count")
  defendersCount     Int              @default(0) @map("defenders_count")
  createdAt          DateTime         @default(now()) @map("created_at")
  finishedAt         DateTime?        @map("finished_at")

  signups HouseSiegeSignup[]

  @@index([status, startsAt])
  @@index([defenderClanId, status])
  @@index([attackerClanId, finishedAt])
  @@map("house_sieges")
}

/// Запись на осаду. Не держит игрока, как заявка на бой: до начала он
/// свободен, а в бой попадает, если в момент старта в игре и не занят.
model HouseSiegeSignup {
  id          String     @id @default(uuid())
  siegeId     String     @map("siege_id")
  characterId String     @map("character_id")
  side        Int // 1 — нападение, 2 — оборона
  createdAt   DateTime   @default(now()) @map("created_at")
  siege       HouseSiege @relation(fields: [siegeId], references: [id], onDelete: Cascade)

  @@unique([siegeId, characterId])
  @@map("house_siege_signups")
}

/// Надпись на стене разгромленного дома.
model HouseWallNote {
  id          String   @id @default(uuid())
  clanId      String   @map("clan_id")
  siegeId     String   @map("siege_id")
  characterId String   @map("character_id")
  text        String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([clanId, createdAt])
  @@index([siegeId, characterId])
  @@map("house_wall_notes")
}

/// Личное уведомление игроку: «посадили», «устроились», «вам сменили должность».
/// Показывается в чате строкой от «Системы»; видит только адресат.
model GameNotice {
  id          String   @id @default(uuid())
  characterId String   @map("character_id")
  text        String   @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([characterId, createdAt])
  @@map("game_notices")
}

/// Журнал склада бригады: кто что положил и взял. Видят глава и заместитель.
model ClanStorageLog {
  id           String   @id @default(uuid())
  clanId       String   @map("clan_id")
  characterId  String   @map("character_id")
  resourceCode String   @map("resource_code")
  /// Плюс — положил, минус — взял.
  amount       Int
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([clanId, createdAt])
  @@map("clan_storage_logs")
}

/// Заметки игрока в «Личном деле» (правка заказчика 21.10): каждый пишет
/// свои — о себе и о любом другом игроке, — и видит только свои.
model PlayerNote {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  targetId  String   @map("target_id")
  text      String   @db.VarChar(4000)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([authorId, targetId])
  @@map("player_notes")
}

/// Постройки двора фермы — без участка (правка заказчика 21.10: «погреб
/// и сторожевая будка строятся отдельно от участков»).
model FarmYardBuilding {
  id          String           @id @default(uuid())
  characterId String           @map("character_id")
  type        FarmBuildingType
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([characterId, type])
  @@map("farm_yard_buildings")
}

// =============================================================
// Жилой сектор (правка заказчика 21.10.2026): квартира или дом игрока.
// Покупается только за доллары, даёт прибавку к боевому опыту и доступ
// к складу, туннели на Стрелки/Промзону/Фермы — за отдельную плату.
// На дом нападают, как на Дом бригады: победа нападающего −10% прочности.
// =============================================================
enum HomeKind {
  APARTMENT
  HOUSE
}

enum HomeRaidStatus {
  PENDING // заявка подана, бой через 72 часа
  IN_BATTLE
  ATTACKER_WON
  DEFENDER_WON
  VOID
}

model PlayerHome {
  id          String   @id @default(uuid())
  characterId String   @unique @map("character_id")
  kind        HomeKind
  /// Номер участка в секторе (1…24): квартиры и дома построены заранее,
  /// игрок покупает свободный. Вид жилья задан номером (housing.config).
  lot         Int?     @unique
  durability  Int      @default(100)
  /// Купленные туннели: коды мест (`pvp`, `industrial`, `farm`).
  tunnels     String[] @default([])
  /// Куда хозяин вышел туннелем (код туннеля): оттуда можно вернуться в дом.
  /// Сбрасывается, когда он ушёл с того места другой дорогой.
  outVia      String?  @map("out_via")
  purchasedAt DateTime @default(now()) @map("purchased_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  character Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  raids     HomeRaid[]
  storage   HomeStorage[]

  @@map("player_homes")
}

/// Склад в квартире или доме (правка заказчика 22.10): «отдельный склад,
/// куда можно выгружать ещё ресурсы. Из центра склад их видно не будет —
/// это только дополнительные ящики в доме».
model HomeStorage {
  id           String     @id @default(uuid())
  homeId       String     @map("home_id")
  resourceCode String     @map("resource_code")
  amount       Int        @default(0)
  updatedAt    DateTime   @updatedAt @map("updated_at")
  home         PlayerHome @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@unique([homeId, resourceCode])
  @@map("home_storage")
}

model HomeRaid {
  id         String         @id @default(uuid())
  homeId     String         @map("home_id")
  attackerId String         @map("attacker_id")
  battleId   String?        @unique @map("battle_id")
  status     HomeRaidStatus @default(PENDING)
  /// Бой — ровно через 72 часа после заявки (правка заказчика 22.10).
  startsAt   DateTime?      @map("starts_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  resolvedAt DateTime?      @map("resolved_at")

  home    PlayerHome       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  signups HomeRaidSignup[]

  @@index([homeId, createdAt])
  @@index([attackerId, createdAt])
  @@index([status, startsAt])
  @@map("home_raids")
}

/// Запись на налёт: сторона 1 — нападение, 2 — оборона, до 10 на сторону.
model HomeRaidSignup {
  id          String   @id @default(uuid())
  raidId      String   @map("raid_id")
  characterId String   @map("character_id")
  side        Int
  createdAt   DateTime @default(now()) @map("created_at")

  raid HomeRaid @relation(fields: [raidId], references: [id], onDelete: Cascade)

  @@unique([raidId, characterId])
  @@map("home_raid_signups")
}

// Обращения в поддержку (правка заказчика 21.10: кнопка «Поддержка» в
// Центре — текст и форма со скриншотом). Ответ приходит игроку уведомлением.
enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

model SupportTicket {
  id          String        @id @default(uuid())
  characterId String        @map("character_id")
  text        String
  /// Скриншот — base64 без префикса data:, как иконка бригады.
  imageData   String?       @map("image_data")
  imageMime   String?       @map("image_mime")
  status      SupportStatus @default(OPEN)
  reply       String?
  repliedAt   DateTime?     @map("replied_at")
  repliedBy   String?       @map("replied_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt])
  @@index([status, createdAt])
  @@map("support_tickets")
}

/// Комплект одежды (обещание игрокам 22.10): до трёх на персонажа, надевается
/// одной кнопкой на Складе или в доме. items — [{ itemId, slot }].
model OutfitPreset {
  id          String   @id @default(uuid())
  characterId String   @map("character_id")
  slot        Int
  name        String   @db.VarChar(32)
  items       Json
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([characterId, slot])
  @@map("outfit_presets")
}
