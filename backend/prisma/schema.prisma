// =============================================================
// PRISMA SCHEMA — Browser MMO 90s
// Этап 1: боевое ядро
// Все таблицы по мастер-ТЗ раздел 15
// =============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

