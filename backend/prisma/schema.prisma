  PVP_DUEL // Простая PvP-дуэль
  PVP_OPEN // Открытая заявка (этап 2+)
  CLAN // Клановый бой (этап 4)
  TERRITORY // Бой за территорию (этап 4)
}

enum BattleStatus {
  CREATED // Создан, ждём игроков
