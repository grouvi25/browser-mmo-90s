/// Что сделал администратор. Значения парные: у каждого действия есть
/// обратное, и оно тоже из этого списка — иначе откат нечем выразить.
/// Действие, для которого пары нет, админу не выдаётся (принцип П1 Этапа 5).
/// Переопределение коэффициента баланса.
///
/// Хранится только разница с кодом: путь в BalanceConfig и новое значение.
/// Пустая таблица означает, что игра работает ровно так, как написано в
/// коде, — поэтому «вернуть исходное» это удаление строки.
model BalanceOverride {
  path         String   @id
  valueJson    Json     @map("value_json")
  /// Что стояло в коде на момент правки: код мог уехать деплоем, а откат
  /// должен возвращать конкретное число, а не «что-то тогдашнее».
  previousJson Json     @map("previous_json")
  reason       String
  adminId      String   @map("admin_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@index([updatedAt(sort: Desc)])
  @@map("balance_overrides")
}

