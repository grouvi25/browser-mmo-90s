// =============================================================
// USERS & AUTH
// =============================================================

model User {
  id               String     @id @default(uuid())
  login            String     @unique
  email            String     @unique
  /// Почта без псевдонимов: у Gmail без точек, у всех без «+метки», Яндекс
  /// к одному домену (auth/email-policy.ts). Уникальна: один ящик — один
  /// аккаунт (просьба 28.10). У аккаунтов до 28.10 заполнена миграцией.
  emailNormalized  String?    @unique @map("email_normalized")
  passwordHash     String     @map("password_hash")
  status           UserStatus @default(ACTIVE)
  emailVerified    Boolean    @default(false) @map("email_verified")
  banReason        String?    @map("ban_reason")
  mutedUntil       DateTime?  @map("muted_until")
  lastIp           String?    @map("last_ip")
  lastUserAgent    String?    @map("last_user_agent")
  lastLoginAt      DateTime?  @map("last_login_at")
  registeredAt     DateTime   @default(now()) @map("registered_at")
  /// Когда игрок согласился с политикой обработки персональных данных
  /// (152-ФЗ, галочка при регистрации с 21.10.2026). У старых аккаунтов пусто.
  policyAcceptedAt DateTime?  @map("policy_accepted_at")
  /// Кто пригласил (персонаж по реферальной ссылке ?ref=ник). Ставится
  /// только при регистрации и больше не меняется.
  referrerCharacterId String? @map("referrer_character_id")

  // Relations
  character      Character?
  sessions       Session[]
  passwordResets PasswordReset[]

  @@index([referrerCharacterId])
  @@map("users")
}

/// Одноразовая ссылка на новый пароль (просьба игроков 26.10: «нет
/// возможности восстановить пароль при входе с нового устройства»).
/// В базе — только хеш токена: утечка таблицы не даёт войти в аккаунт.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_resets")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") // sha256 of the JWT jti
  expiresAt DateTime  @map("expires_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// =============================================================
// CHARACTER
// =============================================================

model Character {
  id        String             @id @default(uuid())
  userId    String             @unique @map("user_id")
  nickname  String             @unique
  archetype CharacterArchetype
  avatar    String?

  // Battle progression
  battleLevel Int @default(1) @map("battle_level")
  battleExp   Int @default(0) @map("battle_exp")

  // Economic progression (Stage 2+, зарезервировано)
  economicLevel Int @default(0) @map("economic_level")
  economicExp   Int @default(0) @map("economic_exp")

  // Production progression (Stage 2+, зарезервировано)
  productionLevel   Int   @default(0) @map("production_level")
  productionExp     Int   @default(0) @map("production_exp")
  battleLoadoutJson Json? @map("battle_loadout_json")

  // Money
  money       Int       @default(1250) // Стартовые деньги по ТЗ
  /// Игровые доллары — донатная валюта. Покупаются у дилера, тратятся на
  /// премиум и плюшки. Рубли (money) — обычная игровая валюта, не путать.
  dollars     Int       @default(0) @map("dollars")
  /// Дилер получает доллары от администрации и пополняет ими счета игроков.
  isDealer    Boolean   @default(false) @map("is_dealer")
  /// Реферальный счёт в $ — отдельно от dollars (заказчик 28.10): отсюда
  /// игрок сам зачисляет на персонажа или подаёт заявку на вывод на карту.
  referralBalance Int   @default(0) @map("referral_balance")
  /// Всего начислено по рефералке за всё время — для вкладки.
  referralEarned  Int   @default(0) @map("referral_earned")
  /// Модератор игры («Красные»): виден во вкладке Поддержки «Модераторы».
  isModerator Boolean   @default(false) @map("is_moderator")
  /// «Кровавая травма» после проигранной осады: до этого времени в бой нельзя.
  traumaUntil DateTime? @map("trauma_until")

  // HP
  hpCurrent Int @map("hp_current")
  hpMax     Int @map("hp_max")

  // Status
  /// Пол персонажа (правка заказчика): в досье «Муж/Жена».
  /// Рабочий фермы за донат: сам собирает созревший урожай до этой даты.
  farmWorkerUntil DateTime?       @map("farm_worker_until")
  /// Профессия «Торгаш» (правка 21.10): 1 — вещи за рубли, 2 — и за доллары.
  traderLevel     Int             @default(0) @map("trader_level")
  /// Номер магазина торгаша — по нему лавку ищут и рекламируют.
  shopNumber      Int?            @unique @map("shop_number")
  gender          Gender          @default(MALE)
  status          CharacterStatus @default(ACTIVE)

  // Future hooks (задел на этапы 3-4)
  clanId     String? @map("clan_id") // этап 3
  locationId String? @map("location_id") // этап 2

  // Premium (задел этап 4)
  isPremium        Boolean   @default(false) @map("is_premium")
  premiumExpiresAt DateTime? @map("premium_expires_at")

  // Profile extras
  battlesTotal         Int            @default(0) @map("battles_total")
  battlesWon           Int            @default(0) @map("battles_won")
  lastLocation         String         @default("/") @map("last_location")
  jailedUntil          DateTime?      @map("jailed_until")
  jailReason           String?        @map("jail_reason")
  pets                 CharacterPet[]
  location             String? // Текстовое местоположение
  isInvisible          Boolean        @default(false) @map("is_invisible")
  lastBattleFinishedAt DateTime?      @map("last_battle_finished_at")
  alcoholLevel         Int            @default(0) @map("alcohol_level")
  alcoholUpdatedAt     DateTime?      @map("alcohol_updated_at")
  hangoverUntil        DateTime?      @map("hangover_until")
  barBuffAccuracy      Float          @default(0) @map("bar_buff_accuracy")
  barBuffDamage        Float          @default(0) @map("bar_buff_damage")
  barBuffExpiresAt     DateTime?      @map("bar_buff_expires_at")
  lastBarBuffAt        DateTime?      @map("last_bar_buff_at") // для HP recovery
  farmPlots            FarmPlot[]

  createdAt    DateTime @default(now()) @map("created_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  // Relations
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats                CharacterStats?
  items                ItemInstance[]         @relation("OwnerItems")
  weaponSkills         WeaponSkill[]
  battlesAsParticipant BattleParticipant[]
  currencyLogs         CurrencyLog[]
  itemLogs             ItemLog[]
  repairLogs           RepairLog[]
  workShifts           WorkShift[]
  professions          CharacterProfession[]
  resourceStacks       ResourceStack[]
  claimRosters         TerritoryClaimRoster[]
  helpers              Helper[]
  home                 PlayerHome?
  supportTickets       SupportTicket[]
  premiumPurchases     PremiumPurchase[]
  chatMessages         ChatMessage[]

  @@map("characters")
}

model CharacterProfession {
  id             String    @id @default(uuid())
  characterId    String    @map("character_id")
  professionCode String    @map("profession_code")
  level          Int       @default(0)
  exp            Int       @default(0)
  unlockedAt     DateTime  @default(now()) @map("unlocked_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, professionCode])
  @@index([characterId])
  @@map("character_professions")
}

model CharacterStats {
  id          String @id @default(uuid())
  characterId String @unique @map("character_id")

  // Base stats (из ТЗ раздел 17.1)
  str  Int @default(3) // Сила
  agi  Int @default(3) // Ловкость
  rea  Int @default(2) // Реакция
  acc  Int @default(3) // Меткость
  end  Int @default(3) // Выносливость
  luck Int @default(1) // Фарт
  agr  Int @default(1) // Агрессия
  auth Int @default(1) // Авторитет

  // Available points to distribute
  pointsAvailable Int @default(0) @map("points_available")
  /// Свитки перераспределения: два бесплатно, дальше за рубли.
  respecScrolls   Int @default(2) @map("respec_scrolls")

  updatedAt DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_stats")
}

